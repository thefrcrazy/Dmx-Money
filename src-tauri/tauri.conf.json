{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DmxMoney",
  "version": "../package.json",
  "identifier": "com.dmxmoney.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; script-src 'self' 'unsafe-inline' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline' asset: http://asset.localhost; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:5173 ws://localhost:5173 https://github.com https://objects.githubusercontent.com"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/thefrcrazy/Dmx-Money/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENTFFRTVDNjFCRjIyQ0QKUldUTklyOWhYTzVSUFF2aE81TlA5bisveFM5THlHSlBOaFlpbWpTMmdqc3U3bDlpZG05UnFVbVgK",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "fileAssociations": [
      {
        "ext": [
          "dmx"
        ],
        "name": "DMX Money Backup",
        "description": "DMX Money backup file",
        "role": "Editor",
        "mimeType": "application/x-dmxmoney-backup"
      }
    ]
  }
}
